{
  // Cloudflare Worker: точка входа worker/index.ts, SPA-статика и прокси API раньше ассетов.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "okid-doki-2026",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-05-24",
  "observability": {
    "enabled": true
  },
  "assets": {
    // Неизвестные пути отдаём index.html — клиентский роутер React.
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // Прокси /doki-proxy и /okidoki-proxy должны попасть в worker, а не в статику.
    "run_worker_first": ["/doki-proxy", "/doki-proxy/*", "/okidoki-proxy", "/okidoki-proxy/*"]
  },
  "compatibility_flags": ["nodejs_compat"]
}
